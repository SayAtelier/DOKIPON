# ─────────────────────────────────────────────────────────────────────────────
# DOKIPON commerce — LOCAL DEVELOPMENT credentials
#
# READ THIS BEFORE USING ANY VALUE IN THIS FILE.
#
# Every value below is a LOCAL DEVELOPMENT value. None of them is a credential.
# They are published here on purpose, so a local run is reproducible, and that
# is exactly why they must never reach a deployment: anyone who has read this
# repository knows them.
#
# The services refuse to start while a *published* development value is in
# place (see `services/crates/commerce-core/src/secrets.rs`). A local run is
# the one legitimate case for that guard, so this file sets the switch:
#
#     DOKIPON_ALLOW_DEV_SECRETS=1
#
# The values here are NOT the published ones (`dev-only-admin`, `dev-only-key`,
# `dev-channel`, `dev-only-secret`, `dev-only-service-token`). They are
# local-only names, so this file cannot be mistaken for the deployment's
# credential set, and so `DOKIPON_ALLOW_DEV_SECRETS=1` here buys exactly one
# thing: the local run behaves the same way whether it uses these values or
# the published ones. Copying this file into a deployment would put a known
# password, a known token-signing key and a known webhook secret in front of
# the public internet. Do not do that.
#
# HOW A LAUNCHER USES THIS FILE
#
#   docker run --env-file tools/commerce-e2e/mock_data/local/local.env ...
#   set -a; . tools/commerce-e2e/mock_data/local/local.env; set +a   # POSIX sh
#
# The same variables must reach BOTH the product service and the mock that
# stands in for it. `mock-line-identity` reads `LINE_ID_TOKEN_KEY` and
# `LINE_CHANNEL_ID` from the environment and signs with them; the identity
# service verifies with them. A mock that signs with a different key than the
# service verifies with is a mock every test of it gets wrong — that is why
# the mock↔product agreement test
# (`tools/commerce-e2e/agreement/tests/line_token_agreement.rs`) reads the
# values from `local.json` and uses them on both sides.
#
# Per-process ports are NOT here: every service reads its own `PORT`. The port
# map is in `local.json` under `ports`.
# ─────────────────────────────────────────────────────────────────────────────

# The escape hatch for the development-credential guard. A local run sets it.
# A deployment never does.
DOKIPON_ALLOW_DEV_SECRETS=1

# The operator console's credential (commerce-admin).
ADMIN_USER=admin
ADMIN_PASSWORD=local-dev-admin-password

# The LINE id-token signing key (commerce-identity) and the channel id it is
# the audience for. `mock-line-identity` signs with the same key and mints
# tokens for the same channel.
LINE_ID_TOKEN_KEY=local-dev-line-id-token-key
LINE_CHANNEL_ID=local-dev-channel-0001

# The PSP webhook secret (commerce-payment-adapter).
PSP_WEBHOOK_SECRET=local-dev-psp-webhook-secret

# The service-to-service credential: what commerce-admin presents to
# commerce-order to ask for the operator's view of the orders.
SERVICE_TOKEN=local-dev-service-token

# Where the content document is persisted, for the local run. The content
# service starts from an EMPTY document (revision 0) when this is unset, so a
# local run that wants a persisted document points this at a writable path.
# CONTENT_PATH=./.local/content.json
