{
  "schema": "gemarc.scene/v2",
  "version": "5.3",
  "coordinateSystem": {
    "handedness": "left",
    "x": "right",
    "y": "up",
    "z": "forward",
    "unit": "logical-design-unit",
    "cameraForward": "positive-z",
    "projection": "LHC explicit view projection; conversion boundary for RH engines"
  },
  "canonicalGraphRef": "gemarc.architecture/v1",
  "roomsAreVirtual": true,
  "scene": {
    "floorIds": [
      "experience",
      "domain",
      "infrastructure"
    ],
    "viewModes": [
      "3d",
      "4d",
      "5d"
    ],
    "singleGraphRevision": true
  },
  "binding": {
    "id": "binding:event:gateway",
    "flowNodeId": "gateway",
    "graphNodeId": "f-transport",
    "verification": "Designed",
    "mappingEvidence": "Explicit design mapping, not a runtime observation"
  },
  "interaction": {
    "pickPriority": [
      "node",
      "edge",
      "room",
      "floor"
    ],
    "edgePickTolerancePx": 14,
    "nodePickTolerancePx": 24,
    "selectionSemantics": "shared across all dimensions",
    "focusOpacityIsPresentationOnly": true
  },
  "exampleFrame": {
    "id": "frame:CASE-CHECKOUT-003:02",
    "caseId": "CASE-CHECKOUT-003",
    "sequence": 2,
    "logicalTimeMs": 1000,
    "graphNodeId": "f-checkout-state",
    "graphEdgeIds": [],
    "ruleId": "validate-b",
    "animation": "isolate",
    "stateDelta": {
      "paymentStatus": {
        "before": "pending",
        "after": "unknown"
      }
    },
    "evidenceGrade": "Hypothetical"
  },
  "causal": {
    "causalRuleRef": "gemarc.causal/v1",
    "guardLanguage": "restricted deterministic AST (no eval)",
    "maxSteps": 60,
    "branchModes": [
      "normal",
      "abnormal",
      "boundary",
      "recovery",
      "composite"
    ],
    "counterfactualSameWorld": true,
    "compensationNeverAssumesExternalCommit": true
  },
  "a11y": {
    "readableNodeEdgeInspector": true,
    "nonColorStatusText": true,
    "fallbackDiagram2d": true,
    "reduceMotion": true
  },
  "acceptance": {
    "graphIdsStableInAllViews": true,
    "replayDeterministic": true,
    "5dBranchChangesAfterInput": true,
    "leftHandedOrientationTest": true,
    "noInventedEdges": true
  }
}