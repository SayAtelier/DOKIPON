# DOKIPON commerce —— 部署用环境变量
#
# 两版都要（k3s 版用容器内服务名，Vercel 版用 URL）。
# 完整说明见同目录 README.md 与 ../README.md。

# --- 每个服务的 base URL -----------------------------------------------------
# 网关按这些地址转发到归属服务的 Function；admin 门面用同一组变量找上游。
#
# 注意：默认值必须是本地能解析的地址。集群版里的
# "http://commerce-catalog:8082" 这种 Docker 服务名在 Vercel 上解析不了，
# admin 面板会因此返回 503。

CATALOG_URL=http://localhost:8082
CART_URL=http://localhost:8083
ORDER_URL=http://localhost:8085
IDENTITY_URL=http://localhost:8081
INVENTORY_URL=http://localhost:8084
PAYMENT_ADAPTER_URL=http://localhost:8086
CONTENT_URL=http://localhost:8096
ADMIN_URL=http://localhost:8090
GATEWAY_URL=http://localhost:8080

# --- 运营后台的凭据 ---------------------------------------------------------
# 留空则用开发默认值 admin / dev-only-admin。**上线前必须改掉。**
ADMIN_USER=
ADMIN_PASSWORD=

# admin 代客户读订单时呈现的会话 id。
# 订单按 buyer 隔离（x-session-id），没有它每次读订单都会 401。
ADMIN_SESSION_ID=admin-console

# --- 其它 --------------------------------------------------------------------
# 内容文档的路径（commerce-content）
CONTENT_PATH=
# LINE 登录的校验参数（commerce-identity）
LINE_CHANNEL_ID=
LINE_ID_TOKEN_KEY=
# PSP 的 webhook 签名密钥（commerce-payment-adapter）
PSP_WEBHOOK_SECRET=
