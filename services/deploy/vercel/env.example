# DOKIPON commerce —— 部署用环境变量
#
# 两版都要（k3s 版用容器内服务名，Vercel 版用 URL）。
# 完整说明见同目录 README.md 与 ../README.md。
#
# --- 凭据是必填的，不是可选的 -----------------------------------------------
#
# 下面这几项是**凭据**，不是配置：留空不会退回开发默认值，部署会直接起不来。
#
# 原因是开发默认值就写在仓库里（admin / dev-only-admin、dev-only-key、
# dev-only-secret）。一个没设这些变量的部署不会报错，它会照常提供服务——只是
# 任何读过这份源码的人都能登录运营后台、伪造任意 LINE 用户登录、伪造支付
# 回调。所以服务在启动前会检查这些值，没设就拒绝启动。
#
# 本地跑（要接受开发默认值）另外设一个开关：
#
#   DOKIPON_ALLOW_DEV_SECRETS=1
#
# 部署**永远不要**设这个开关。

# --- 每个服务的 base URL -----------------------------------------------------
# 网关按这些地址转发到归属服务的 Function；admin 门面用同一组变量找上游。
#
# 注意：默认值必须是本地能解析的地址。集群版里的
# "http://commerce-catalog:8082" 这种 Docker 服务名在 Vercel 上解析不了，
# admin 面板会因此返回 503。

CATALOG_URL=http://localhost:8082
CART_URL=http://localhost:8083
ORDER_URL=http://localhost:8085
IDENTITY_URL=http://localhost:8081
INVENTORY_URL=http://localhost:8084
PAYMENT_ADAPTER_URL=http://localhost:8086
CONTENT_URL=http://localhost:8096
ADMIN_URL=http://localhost:8090

# --- 运营后台的凭据 ---------------------------------------------------------
# 必填。没有默认值：留空 = 部署起不来。
ADMIN_USER=operator
ADMIN_PASSWORD=

# 服务到服务的凭据。admin 门面拿它去向订单服务要「跨会话的订单视图」——
# 那是买家看不到、只有运营能看的那一份，所以订单服务只认带这个值的调用方。
# 浏览器永远拿不到它。
SERVICE_TOKEN=

# admin 代客户读订单时呈现的会话 id。
# 订单按 buyer 隔离（x-session-id），没有它每次读订单都会 401。
ADMIN_SESSION_ID=admin-console

# --- 其它 --------------------------------------------------------------------
# 内容文档的路径（commerce-content）
CONTENT_PATH=
# LINE 登录的校验参数（commerce-identity）—— 必填
LINE_CHANNEL_ID=
LINE_ID_TOKEN_KEY=
# PSP 的 webhook 签名密钥（commerce-payment-adapter）—— 必填
PSP_WEBHOOK_SECRET=
