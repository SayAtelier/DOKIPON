{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "bash services/deploy/vercel/build-vercel.sh",
  "installCommand": "echo skipped",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/svc/catalog/(.*)", "destination": "/api/svc/catalog" },
    { "source": "/api/svc/cart/(.*)", "destination": "/api/svc/cart" },
    { "source": "/api/svc/order/(.*)", "destination": "/api/svc/order" },
    { "source": "/api/svc/content/(.*)", "destination": "/api/svc/content" },
    { "source": "/api/svc/identity/(.*)", "destination": "/api/svc/identity" },
    { "source": "/api/svc/inventory/(.*)", "destination": "/api/svc/inventory" },
    { "source": "/api/svc/payment/(.*)", "destination": "/api/svc/payment" },
    { "source": "/api/svc/admin/(.*)", "destination": "/api/svc/admin" },
    { "source": "/v1/(.*)", "destination": "/api/gateway" },
    { "source": "/admin/v1/(.*)", "destination": "/api/gateway" },
    { "source": "/healthz", "destination": "/api/gateway" },
    { "source": "/api/(.*)", "destination": "/api/index" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/canvaskit/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/admin/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/admin/canvaskit/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/flutter_service_worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
